# FixNaija Intelligence Configuration

# Database
DATABASE_PATH=./database/fixnaija.db

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Optional: Government API endpoints (when available)
# GOVERNMENT_API_KEY=your_key_here
# GOVERNMENT_API_URL=https://api.example.com

# Optional: Email configuration for authority alerts
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# ALERT_EMAIL_FROM=alerts@fixnaija.ng
# ALERT_EMAIL_PASSWORD=your_password

# Optional: Map service (Mapbox, Google Maps, etc.)
# MAP_SERVICE_KEY=your_key_here
